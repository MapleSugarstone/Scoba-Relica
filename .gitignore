node_modules/
dist/
*.local
world.json.bak

# Local relay state: miniflare's own sqlite for `wrangler dev`, holding
# whatever rooms were opened while testing.
.wrangler/

# Working notes and local editor config. Kept on disk, kept out of the repo.
claude-notes/
.claude/

# Local worker secrets for `wrangler dev`. Never committed.
.dev.vars

# Anything the VAPID generator writes. The script itself is safe to commit
# (it holds no keys, it makes them), but its output carries the private half,
# so the glob is deliberately wider than the one filename we use.
vapid*.txt
vapid*.json
*vapid-secrets*
